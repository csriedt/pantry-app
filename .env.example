# Copy to .env.local and fill in from your Supabase project settings.

# Project API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_PROJECT_ID=

# Direct database connection, used by drizzle-kit and the RLS test suite.
# The pooler URL on port 5432 is the one that works from most networks.
DATABASE_URL=
